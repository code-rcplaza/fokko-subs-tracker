# Copia este archivo a .env (ignorado por git) y cambia lo que necesites.
# Los valores de aquí son de ejemplo: nunca pongas una llave real en este archivo.

# development: los códigos de acceso se imprimen en la consola (docker compose logs).
# production: se envían por correo con Resend y exige las dos variables de abajo.
MAILCHECKER_ENV=development

# Solo con MAILCHECKER_ENV=production. Llave falsa de ejemplo.
MAILCHECKER_RESEND_API_KEY=re_ejemplo_no_es_una_llave_real
# Remitente de los correos con el código (dominio verificado en Resend).
MAILCHECKER_MAIL_FROM=Fokko Subs <codigos@example.com>

# Puerto del host donde se publica la app (dentro del contenedor siempre es 8080).
FOKKO_HOST_PORT=8080
